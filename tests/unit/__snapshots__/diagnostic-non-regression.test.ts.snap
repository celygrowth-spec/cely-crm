          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "version": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer",
        },
      },
      "required": [
        "diagnostic_id",
        "version",
      ],
      "type": "object",
    },
    "name": "confirm_diagnostic_version",
    "title": "Confirmer le dépôt d'une version",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "Indique à l'utilisateur que le travail n'a pas abouti, avec la raison exacte.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "diagnostic_id": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "diagnostic_id",
        "message",
      ],
      "type": "object",
    },
    "name": "report_diagnostic_failure",
    "title": "Signaler un échec",
  },
]
`;

