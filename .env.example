# Copier en .env.local (jamais versionné) puis renseigner.
# Ces variables sont lues uniquement côté serveur : rien n'est envoyé au navigateur.

# Supabase › Project Settings › API › Project URL
SUPABASE_URL=https://votre-projet.supabase.co

# Supabase › Project Settings › API Keys › Publishable key (sb_publishable_…)
# (ou l'ancienne clé « anon »). Ne mettez JAMAIS la clé secrète / service_role ici.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Système mail (facultatif tant que Gmail n'est pas connecté) : voir docs/mail-configuration.md
# Google Cloud › Google Auth Platform › Clients : client de type « Application Web », dédié au mail.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
# Clé de chiffrement des jetons (32 octets en base64) : openssl rand -base64 32
# La changer rend les jetons illisibles : il faudra reconnecter Gmail.
MAIL_TOKEN_KEY=

# --- Rendez-vous (voir docs/integrations/google-calendar.md) ---
# Secret serveur, 32 caractères minimum : openssl rand -base64 48
APPOINTMENTS_SECRET=
# Client OAuth Google « Application Web » (peut être celui du module Mail : GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# URL publique de l'application (liens privés, retour OAuth)
APP_URL=
# Facultatif : tâche planifiée de reprise Google (/api/rendez-vous/reconcile)
CRON_SECRET=

# --- Fireflies (voir docs/integrations/fireflies.md) ---
# Fireflies › Integrations › Fireflies API : clé API du compte dont on importe les appels
FIREFLIES_API_KEY=
# Secret de signature des webhooks, 16 caractères minimum : openssl rand -hex 32
# La même valeur se colle dans Fireflies › Webhooks V2 › Signing secret
FIREFLIES_WEBHOOK_SECRET=
# APPOINTMENTS_SECRET (clé serveur) et CRON_SECRET (passage quotidien) ci-dessus sont aussi nécessaires
